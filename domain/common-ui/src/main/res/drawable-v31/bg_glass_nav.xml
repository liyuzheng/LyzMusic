<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 使用的玻璃胶囊背景，样式与基础资源保持一致 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#7AFFFFFF"
        android:centerColor="#4DFFFFFF"
        android:endColor="#26FFFFFF"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#B3FFFFFF" />
</shape>

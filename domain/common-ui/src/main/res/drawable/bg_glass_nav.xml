<?xml version="1.0" encoding="utf-8"?>
<!-- 基础玻璃胶囊背景：半透明渐变 + 圆角 + 白色描边，作为低版本兼容回退 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#7AFFFFFF"
        android:centerColor="#4DFFFFFF"
        android:endColor="#26FFFFFF"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#B3FFFFFF" />
</shape>

<resources>
    <!-- 1. 启动专用主题（黑底） -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 启动屏背景设为纯黑 -->
        <item name="windowSplashScreenBackground">@color/black</item>
        <!-- 中央启动图标 -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <!-- 关键：启动结束后自动切换到的主应用主题 -->
        <item name="postSplashScreenTheme">@style/Theme.LyzMusic</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 2. 主应用正常主题（白底 + 深色状态栏文字） -->
    <style name="Theme.LyzMusic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 页面默认窗口背景设为白色 -->
        <item name="android:windowBackground">@color/white</item>
        <!-- 状态栏与导航栏背景设为透明（配合 Edge-to-Edge） -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 关键：白底页面必须将状态栏与导航栏图标设为深色（黑字），否则看不见 -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>